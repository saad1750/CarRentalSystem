# Kopiér til .env og ret værdierne:  cp .env.example .env
# .env må IKKE committes (står i .gitignore).

# --- Generelt ---
ASPNETCORE_ENVIRONMENT=Development
# Registry/tag bruges når images pushes/pulles (CI/CD). Lokalt er default fint.
IMAGE_REGISTRY=ghcr.io/dit-github-brugernavn/carrentalsystem
IMAGE_TAG=latest

# --- Porte på din egen maskine (host) ---
USER_SERVICE_PORT=6001
CAR_SERVICE_PORT=6002
BOOKING_SERVICE_PORT=6003
NOTIFICATION_SERVICE_PORT=6004
PAYMENT_SERVICE_PORT=6005
RABBITMQ_UI_PORT=15672

# --- Databaser (én PostgreSQL-server pr. service) ---
POSTGRES_USER=carrental
POSTGRES_PASSWORD=skift-mig
USER_DB_NAME=userdb
CAR_DB_NAME=cardb
BOOKING_DB_NAME=bookingdb
PAYMENT_DB_NAME=paymentdb

# --- Message broker ---
RABBITMQ_USER=carrental
RABBITMQ_PASSWORD=skift-mig
