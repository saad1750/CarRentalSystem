<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet leder efter denne fil op igennem mappestrukturen fra det projekt der
  restores, så alle services i dette repo finder den automatisk.
  "local-shared" peger på mappen CarRental.Shared lægger sin .nupkg i
  (se PackageOutputPath i CarRental.Shared.csproj) — ingen ekstern server nødvendig.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-shared" value="./local-nuget-feed" />
  </packageSources>
</configuration>
